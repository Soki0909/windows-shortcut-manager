<Window x:Class="ShortcutManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShortcutManager.App"
        Title="Shortcut Manager" Width="1180" Height="800" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Icon="Assets/shortcut_manager_logo.ico">
  <Window.Resources>
    <Style x:Key="KeyTileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="82"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource KeyDefaultBorderBrush}"/>
      <Setter Property="IsEnabled" Value="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Background" Value="{DynamicResource KeyReadyBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource KeyReadyBorderBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="{DynamicResource KeyDisabledBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource KeyDisabledBorderBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="{DynamicResource KeyErrorBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource KeyErrorBorderBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Unapplied Changes"><Setter Property="Background" Value="{DynamicResource KeyChangedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource KeyChangedBorderBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="KeyTileTemplate">
      <Button Style="{StaticResource KeyTileStyle}" Click="KeyTile_Click" Tag="{Binding}" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Key}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="66"/>
          <TextBlock Grid.Row="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
        </Grid>
      </Button>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="KeyboardRowPanel"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  </Window.Resources>

  <Border Padding="22">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <Grid MinWidth="960" MinHeight="660" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" IsEnabled="{Binding CanInteract}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image x:Name="ProductLogo" Source="Assets/shortcut_manager_logo_64.png" Width="40" Height="40"
                 Margin="0,0,11,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Shortcut Manager ロゴ"/>
          <StackPanel>
            <TextBlock x:Name="ProductTitle" Text="Shortcut Manager" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Ctrl + Alt + A–Z · ローカルで安全に管理" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
            <TextBlock x:Name="DevelopmentNotice" Text="デバッグ版 · 設定とショートカットキーは製品版と別に保存"
                       Visibility="Collapsed" Foreground="{DynamicResource DebugNoticeBrush}" FontSize="11" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="既存をスキャン" Click="Scan_Click" Style="{StaticResource QuietButtonStyle}" IsEnabled="{Binding CanModify}"/>
          <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,0">
            <MenuItem Header="確認と復旧(_R)" Padding="12,8">
              <MenuItem Header="選択した割当の全文・検証結果…" Click="Details_Click" IsEnabled="{Binding CanEditSelected}"/>
              <MenuItem Header="選択した起動内容をプレビュー…" Click="Preview_Click" IsEnabled="{Binding CanEditSelected}"/>
              <Separator/>
              <MenuItem Header="保存済みを監査（編集は保持）" Click="AuditSaved_Click" IsEnabled="{Binding CanAuditSaved}"/>
              <MenuItem Header="監査・修復の履歴…" Click="AuditHistory_Click"/>
              <MenuItem Header="保存済みの管理リンクを明示修復…" Click="RepairSaved_Click" IsEnabled="{Binding CanRepairSaved}"/>
              <MenuItem Header="次回から監査のみ（自動修復を保留）" IsCheckable="True" IsChecked="{Binding AuditOnly, Mode=TwoWay}"/>
              <MenuItem Header="中断した反映を復旧…" Click="RecoverPending_Click"/>
              <MenuItem Header="選択キーの実動作を確認済みにする" Click="ConfirmHotkey_Click" IsEnabled="{Binding CanConfirmHotkey}"/>
              <Separator/>
              <MenuItem Header="{Binding ReloadLabel}" Click="Reload_Click"/>
              <MenuItem Header="エクスプローラーを再起動…" Click="ShellReload_Click"/>
              <Separator/>
              <MenuItem Header="バックアップ…" Click="Backup_Click"/>
              <MenuItem Header="バックアップを復元…" Click="Restore_Click" IsEnabled="{Binding CanRestore}"/>
              <MenuItem Header="バックアップ履歴…" Click="BackupHistory_Click" IsEnabled="{Binding CanRestore}"/>
              <MenuItem Header="今回直前の反映を戻す…" Click="UndoApply_Click" IsEnabled="{Binding CanUndoLastApply}" ToolTip="今回の起動中に行った直前の反映だけを、対応するバックアップから確認して戻します。未保存の候補がある場合は先に整理してください。"/>
              <MenuItem Header="起動診断…" Click="LaunchDiagnostics_Click"/>
              <MenuItem Header="報告用の診断を確認・保存…" Click="ExportDiagnostic_Click" IsEnabled="{Binding CanInteract}"/>
              <MenuItem Header="復旧用初期化…" Click="InitializeRecovery_Click" IsEnabled="{Binding CanInitializeRecovery}">
                <MenuItem.Style><Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecoveryRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
              </MenuItem>
            </MenuItem>
          </Menu>
          <Button Content="設定(_O)" Click="Settings_Click" IsEnabled="{Binding CanModify}"/>
          <Button Content="使い方(_H)" Click="Help_Click"/>
          <Button Content="情報(_V)" Click="About_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,14">
      <StackPanel>
        <Grid Margin="2,0,2,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="キーボード" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="キーを選ぶと、その割り当てをすぐ編集できます" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}"/><TextBlock Text=" 保存済み" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,14,0"/>
            <Ellipse Width="8" Height="8" Fill="{DynamicResource KeyChangedBorderBrush}"/><TextBlock Text=" 未保存" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,14,0"/>
            <Ellipse Width="8" Height="8" Fill="{DynamicResource KeyDefaultBorderBrush}"/><TextBlock Text=" 空き" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding TopRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding HomeRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding BottomRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18,12,15,9">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ショートカット" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectionText}" ToolTip="{Binding SelectionText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="追加(_A)" Click="Add_Click" IsEnabled="{Binding CanModify}"/>
            <Button Content="編集(_E)" Click="Edit_Click" IsEnabled="{Binding CanEditSelected}"/>
            <Button Content="削除(_D)" Click="Delete_Click" IsEnabled="{Binding CanEditSelected}"/>
            <Button Content="{x:Static local:UiText.TestTargetWithAccessKey}" Click="Test_Click" IsEnabled="{Binding CanEditSelected}" ToolTip="登録した対象を実際に起動します。実際にキーを押す確認とは別です。"/>
            <Button Content="{x:Static local:UiText.ApplyWithAccessKey}" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" Padding="18,8" IsEnabled="{Binding CanApply}"/>
          </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="割当の一覧" AutomationProperties.HelpText="上下矢印で選択し、Alt+Eで編集、Alt+Tで対象をテストできます。" MouseDoubleClick="Grid_DoubleClick" AlternationCount="2">
          <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name" Value="{Binding FullDescription}"/></Style></DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled, Mode=OneWay}" Width="58"/>
            <DataGridTextColumn Header="{x:Static local:UiText.ShortcutKey}" Binding="{Binding Hotkey, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="136"/>
            <DataGridTextColumn Header="名前" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="1.1*"/>
            <DataGridTextColumn Header="種類" Binding="{Binding Type, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="140"/>
            <DataGridTextColumn Header="起動先" Binding="{Binding Target, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="2*"/>
            <DataGridTextColumn Header="状態" Binding="{Binding StateLabel, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="180"/>
          </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
          <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
          <StackPanel Margin="18,10" HorizontalAlignment="Center" MaxWidth="620">
            <TextBlock Text="よく使うサイトやアプリを、キーひとつに。" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="まず1件追加し、対象をテストしてから変更を反映します。登録後はこのアプリを閉じても使えます。" TextWrapping="Wrap" Margin="0,7,0,10"/>
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="Webサイトを追加" Click="AddWebsite_Click" ToolTip="URLを登録します。Chrome拡張は不要です。"/>
              <Button Content="アプリを追加" Click="AddApplication_Click" ToolTip="実行ファイルや既存のWindowsショートカットを登録します。"/>
              <Button Content="既存から移行" Click="Scan_Click" ToolTip="既存の割当を読み取って候補へ取り込みます。元ファイルは変更しません。"/>
              <Button Content="初回ガイド" Click="Guide_Click"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
          <TextBlock Text="{Binding ManagedDirectory, StringFormat=管理フォルダ: {0}}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource StatusPanelBrush}" CornerRadius="10" Padding="13,9" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding EditingNotice}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LogWarning}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LogWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding RestoreNotice}" TextWrapping="Wrap" FontWeight="SemiBold">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding RestoreNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="StatusAnnouncement" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Status}" AutomationProperties.HelpText="処理結果"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button Content="状態の詳細" Click="StateDetails_Click" Padding="8,3" ToolTip="保存設定・リンク監査・エクスプローラー反映・実キーの確認を分けて表示します。"/>
          <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" Margin="4,4,4,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource ProgressTrackBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
  </Border>
</Window>
