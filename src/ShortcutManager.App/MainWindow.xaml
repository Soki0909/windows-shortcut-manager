<Window x:Class="ShortcutManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut Manager" Width="1180" Height="800" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Icon="Assets/shortcut_manager_logo.ico">
  <Window.Resources>
    <Style x:Key="KeyTileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="82"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DCE2EB"/>
      <Setter Property="IsEnabled" Value="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Background" Value="#ECF8F3"/><Setter Property="BorderBrush" Value="#A9DCCB"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="#F3F4F6"/><Setter Property="BorderBrush" Value="#D5D9E0"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="#FFF0F1"/><Setter Property="BorderBrush" Value="#F2B8BE"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Unapplied Changes"><Setter Property="Background" Value="#F0EFFF"/><Setter Property="BorderBrush" Value="#C9C5FF"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="KeyTileTemplate">
      <Button Style="{StaticResource KeyTileStyle}" Click="KeyTile_Click" Tag="{Binding}" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Key}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="66"/>
          <TextBlock Grid.Row="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
        </Grid>
      </Button>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="KeyboardRowPanel"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  </Window.Resources>

  <Border Padding="22">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <Grid MinWidth="960" MinHeight="660" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" IsEnabled="{Binding CanInteract}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image x:Name="ProductLogo" Source="Assets/shortcut_manager_logo_64.png" Width="40" Height="40"
                 Margin="0,0,11,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Shortcut Manager ロゴ"/>
          <StackPanel>
            <TextBlock x:Name="ProductTitle" Text="Shortcut Manager" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Ctrl + Alt + A–Z · ローカルで安全に管理" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            <TextBlock x:Name="DevelopmentNotice" Text="デバッグ版 · 設定とHotKeyは製品版と別に保存"
                       Visibility="Collapsed" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="既存をスキャン" Click="Scan_Click" Style="{StaticResource QuietButtonStyle}" IsEnabled="{Binding CanModify}"/>
          <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,0">
            <MenuItem Header="確認と復旧" Padding="12,8">
              <MenuItem Header="保存済みを監査（編集は保持）" Click="AuditSaved_Click" IsEnabled="{Binding CanAuditSaved}"/>
              <MenuItem Header="選択キーの実動作を確認済みにする" Click="ConfirmHotkey_Click" IsEnabled="{Binding CanConfirmHotkey}"/>
              <Separator/>
              <MenuItem Header="{Binding ReloadLabel}" Click="Reload_Click"/>
              <MenuItem Header="Explorerを再起動…" Click="ShellReload_Click"/>
              <Separator/>
              <MenuItem Header="バックアップ…" Click="Backup_Click"/>
              <MenuItem Header="バックアップを復元…" Click="Restore_Click" IsEnabled="{Binding CanRestore}"/>
              <MenuItem Header="起動診断…" Click="LaunchDiagnostics_Click"/>
              <MenuItem Header="復旧用初期化…" Click="InitializeRecovery_Click" IsEnabled="{Binding CanInitializeRecovery}">
                <MenuItem.Style><Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecoveryRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
              </MenuItem>
            </MenuItem>
          </Menu>
          <Button Content="設定" Click="Settings_Click" IsEnabled="{Binding CanModify}"/>
          <Button Content="使い方" Click="Help_Click"/>
          <Button Content="情報" Click="About_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,14">
      <StackPanel>
        <Grid Margin="2,0,2,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="キーボード" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="キーを選ぶと、その割り当てをすぐ編集できます" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/><TextBlock Text=" 保存済み" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,14,0"/>
            <Ellipse Width="8" Height="8" Fill="#C9C5FF"/><TextBlock Text=" 未保存" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,14,0"/>
            <Ellipse Width="8" Height="8" Fill="#DCE2EB"/><TextBlock Text=" 空き" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding TopRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding HomeRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding BottomRowKeys}" ItemTemplate="{StaticResource KeyTileTemplate}" ItemsPanel="{StaticResource KeyboardRowPanel}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18,12,15,9">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ショートカット" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectionText}" ToolTip="{Binding SelectionText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="追加" Click="Add_Click" IsEnabled="{Binding CanModify}"/>
            <Button Content="編集" Click="Edit_Click" IsEnabled="{Binding CanEditSelected}"/>
            <Button Content="削除" Click="Delete_Click" IsEnabled="{Binding CanEditSelected}"/>
            <Button Content="対象をテスト" Click="Test_Click" IsEnabled="{Binding CanEditSelected}" ToolTip="登録した対象を実際に起動します。物理キーのテストとは別です。"/>
            <Button Content="変更を反映" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" Padding="18,8" IsEnabled="{Binding CanApply}"/>
          </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick" AlternationCount="2">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled, Mode=OneWay}" Width="58"/>
            <DataGridTextColumn Header="HotKey" Binding="{Binding Hotkey, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="118"/>
            <DataGridTextColumn Header="名前" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="1.1*"/>
            <DataGridTextColumn Header="種類" Binding="{Binding Type, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="110"/>
            <DataGridTextColumn Header="起動先" Binding="{Binding Target, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="2*"/>
            <DataGridTextColumn Header="状態" Binding="{Binding StateLabel, Mode=OneWay}" ElementStyle="{StaticResource GridCellTextStyle}" Width="180"/>
          </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}">
          <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
          <StackPanel Margin="18,10" HorizontalAlignment="Center" MaxWidth="620">
            <TextBlock Text="よく使うサイトやアプリを、キーひとつに。" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="まず1件追加し、対象をテストしてから変更を反映します。登録後はこのアプリを閉じても使えます。" TextWrapping="Wrap" Margin="0,7,0,10"/>
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="Webサイトを追加" Click="AddWebsite_Click" ToolTip="URLを登録します。Chrome拡張は不要です。"/>
              <Button Content="アプリを追加" Click="AddApplication_Click" ToolTip="実行ファイルや既存のWindowsショートカットを登録します。"/>
              <Button Content="既存から移行" Click="Scan_Click" ToolTip="既存の割当を読み取って候補へ取り込みます。元ファイルは変更しません。"/>
              <Button Content="初回ガイド" Click="Guide_Click"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
          <TextBlock Text="{Binding ManagedDirectory, StringFormat=管理フォルダ: {0}}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#EEF1F7" CornerRadius="10" Padding="13,9" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding EditingNotice}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LogWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LogWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding RestoreNotice}" TextWrapping="Wrap" FontWeight="SemiBold">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding RestoreNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button Content="状態の詳細" Click="StateDetails_Click" Padding="8,3" ToolTip="保存設定・リンク監査・Explorer反映・実キーの確認を分けて表示します。"/>
          <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" Margin="4,4,4,0" Foreground="{StaticResource PrimaryBrush}" Background="#DDE2EC"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
  </Border>
</Window>
