<Window x:Class="ShortcutManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shortcut Manager" Width="1100" Height="720" MinWidth="900" MinHeight="600" Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Window.Resources>
  <DockPanel Margin="14">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Shortcut Manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + A-Z / v0.1.0" Opacity=".65"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="既存をスキャン" Click="Scan_Click"/><Button Content="バックアップ" Click="Backup_Click"/><Button Content="復元" Click="Restore_Click"/><Button Content="設定" Click="Settings_Click"/><Button Content="About" Click="About_Click"/>
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom">
      <Border Background="#FFF3F4F6" CornerRadius="6" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,7,0,0"/></StackPanel></Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><Button Content="追加" Click="Add_Click"/><Button Content="編集" Click="Edit_Click"/><Button Content="削除" Click="Delete_Click"/><Button Content="テスト起動" Click="Test_Click"/><Button Content="Reload" Click="Reload_Click"/><Button Content="Apply" FontWeight="Bold" Click="Apply_Click"/></StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="A-Z キー概要" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding Keys}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="13" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Button Click="KeyTile_Click" Tag="{Binding}" MinHeight="76"><StackPanel><TextBlock Text="{Binding Key}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/><TextBlock Text="{Binding Status}" FontSize="10" Opacity=".65" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="ショートカット" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <DataGrid ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MinHeight="280" MouseDoubleClick="Grid_DoubleClick">
          <DataGrid.Columns><DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled, Mode=OneWay}"/><DataGridTextColumn Header="HotKey" Binding="{Binding Hotkey, Mode=OneWay}"/><DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}"/><DataGridTextColumn Header="Target" Binding="{Binding Target, Mode=OneWay}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding ManagedDirectory, StringFormat=管理フォルダ: {0}}" FontSize="11" Opacity=".6" Margin="0,6,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
