{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shortcut Manager Dispatcher Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "code",
        "groupTitle",
        "groupId",
        "windowId",
        "tabId"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "code": {
          "const": "ok"
        },
        "groupTitle": {
          "type": "string"
        },
        "groupId": {
          "type": "integer"
        },
        "windowId": {
          "type": "integer"
        },
        "tabId": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "code",
        "message"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "invalid-protocol",
            "invalid-action",
            "empty-group-name",
            "group-not-found",
            "group-query-failed",
            "group-expand-failed",
            "window-focus-failed",
            "tab-query-failed",
            "tab-activate-failed",
            "internal-error"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  ]
}