{
  "manifest_version": 3,
  "name": "Tab Group Launcher",
  "version": "1.1.2",
  "description": "Windows側のショートカットから既存のChromeタブグループへ移動するPoC。",
  "permissions": [
    "tabGroups",
    "tabs",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Tab Group Launcher",
    "default_popup": "popup.html"
  }
}
